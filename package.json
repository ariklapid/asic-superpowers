{
  "name": "asic-superpowers",
  "version": "5.1.1",
  "description": "Evidence-first Superpowers methodology for ASIC RTL, DV, and Physical Design agents.",
  "type": "module",
  "main": ".opencode/plugins/asic-superpowers.js",
  "author": "ariklapid",
  "license": "MIT",
  "homepage": "https://github.com/ariklapid/asic-superpowers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariklapid/asic-superpowers.git"
  },
  "scripts": {
    "sync:upstream": "scripts/run-python.sh scripts/prepare_upstream_superpowers_sync.py",
    "sync:upstream:mark": "scripts/run-python.sh scripts/prepare_upstream_superpowers_sync.py --mark-synced latest",
    "monitor:upstream-releases": "scripts/run-python.sh scripts/monitor_upstream_superpowers_releases.py",
    "test:upstream-monitor": "scripts/run-python.sh -m unittest discover -s tests/upstream-release-monitor -p 'test_*.py' -v",
    "validate:skills": "scripts/run-python.sh scripts/check_skill_contracts.py",
    "validate:links": "scripts/run-python.sh scripts/check_links.py",
    "validate:triggers": "scripts/run-python.sh scripts/check_trigger_metadata.py",
    "eval:asic": "scripts/run-python.sh scripts/run_asic_evals.py",
    "validate": "scripts/validate.sh"
  }
}
